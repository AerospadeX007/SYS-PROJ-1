// Section 2 (system-level tool) code flow chart -- A.5.b / G.3
// Regenerate: dot -Tpdf S2_code_flowchart.dot -o S2_code_flowchart.pdf ; dot -Tpng -Gdpi=150 S2_code_flowchart.dot -o S2_code_flowchart.png
// Author: Shaunn Pavelik (10/8/2026; updated 10/14 for J-2X + cross-check; 10/15 for S2_2's all-teammate
// loop and S2_1_HCR's diameter sweep), from the call graph of the Section 2 files on main
digraph S2 {
  rankdir=LR; newrank=true; nodesep=0.18; ranksep=0.55; compound=true;
  graph [fontname="Helvetica", fontsize=20, labelloc=t, label="Team 3 - ENAE 483 Project 1 - Section 2 System-Level Tools: Code Flow Chart\n"];
  node  [shape=ellipse, fontname="Helvetica", fontsize=13, style=filled, fillcolor="#ffffff", color="#33415c", penwidth=1.3];
  edge  [color="#4a5568", arrowsize=0.7, penwidth=1.1];

  subgraph cluster_main { label="main_section2.py  (Pavelik)"; style="rounded,filled"; fillcolor="#fdf3dc"; color="#e0a526"; fontsize=14;
    main [label="main\n(every S.2 output: tables,\ngraphs, sketches, 25-pair matrix)", shape=box, style="rounded,filled,bold", fillcolor="#fbe3a6"];
    summary; tag_of;
  }
  subgraph cluster_s21 { label="S2_1.py  (Harmon: structure, loop, printing | Kahn: tanks, tank/insulation/engine MERs | Rowley: shell geometry, J-2X | Pavelik: MERs, dV closure, diameter + engine fit)"; style="rounded,filled"; fillcolor="#e7eef9"; color="#2a78d6"; fontsize=14;
    s21main [label="__main__\n(one design)", shape=box, style="rounded,filled,bold", fillcolor="#c9daf3"];
    run_systems_analysis [label="run_systems_analysis"]; choose_diameter [label="choose_diameter\n(L/D <= 13, engines fit)"];
    _size_vehicle [label="_size_vehicle\n(iterate to convergence)"];
    calculate_stage_subsystems [label="calculate_stage_subsystems\n(one stage)"];
    calculate_propellant_geometry; tank_shape; stage_layout;
    cylinder_side_area; cone_side_area; frustum_side_area;
    calculate_engine_count [label="calculate_engine_count\n(T/W 1.3 / 0.76)"]; engine_base_diameter;
    stage_engine [label="stage_engine\n(Table 2 or J-2X)"];
    print_vehicle_results; print_stage_results;
    subgraph cluster_mer { label="Lecture 8 MERs"; style="rounded,filled"; fillcolor="#f5f8fd"; color="#9ab4dc"; fontsize=13;
      mer_tank_mass; mer_insulation_mass; mer_engine_mass; mer_thrust_structure_mass; mer_solid_casing_mass;
      mer_gimbal_mass; mer_avionics_mass; mer_wiring_mass;
      mer_payload_fairing_mass; mer_intertank_mass; mer_interstage_mass; mer_aft_fairing_mass; mer_fairing_mass;
    }
  }
  subgraph cluster_s22 { label="S2_2.py  (Menon: tables, all-teammate loop | Pavelik: cost fix)"; style="rounded,filled"; fillcolor="#e6f4ec"; color="#2f8f5b"; fontsize=14;
    s22main [label="__main__\n(all 10 team designs)", shape=box, style="rounded,filled,bold", fillcolor="#c5e6d2"];
    generate_all_tables [label="generate_all_tables\n(loop over teammates)"];
    create_table_of_masses [label="create_table_of_masses\n(S.2.2 CSV)"];
  }
  subgraph cluster_hcr { label="S2_1_HCR.py  (Rowley: independent system-level tool)"; style="rounded,filled"; fillcolor="#fde9e4"; color="#eb6834"; fontsize=14;
    hcrmain [label="__main__\n(one design)", shape=box, style="rounded,filled,bold", fillcolor="#f8cfc2"];
    hcr_run [label="run_systems_analysis\n(diameter sweep 5.2-13 m)"];
    solve_vehicle [label="solve_vehicle\n(iterate to convergence)"];
    size_stage [label="size_stage\n(MERs, one stage)"];
    format_stage_for_s2_2; get_stage_prop_specs [label="get_stage_prop_specs\n(Table 2 or J-2X)"];
    tank_geometry; payload_fairing_geometry; shell_fairing_mass; engine_pack_diameter;
  }
  subgraph cluster_x { label="S2_crosscheck_HCR.py  (Pavelik: S2_1 vs S2_1_HCR verification)"; style="rounded,filled"; fillcolor="#fff4f0"; color="#eb6834"; fontsize=14;
    xmain [label="__main__\n(compare both tools)", shape=box, style="rounded,filled,bold", fillcolor="#f8cfc2"];
    henry_diameter; s2_1 [label="s2_1\n(S2_1 at the same D)"];
  }
  subgraph cluster_graph { label="S2_auto_graph.py  (Pavelik; Kahn auto graphs)"; style="rounded,filled"; fillcolor="#f6ecf9"; color="#8e5bb5"; fontsize=14;
    section1_splits; sweep_dv1; plot_breakdown; plot_vl_vs_sl; plot_vehicle_sketch; plot_dv1_sweep;
    plot_team_designs; plot_team_scatter; plot_group_matrix;
  }
  subgraph cluster_s1 { label="Section 1 tools reused (s1/, utils/)"; style="rounded,filled"; fillcolor="#f1f1ee"; color="#8a8a85"; fontsize=14;
    calculate_stage_masses [label="calculate_stage_masses\n(s1_1, Rowley)"]; stage_cost [label="stage_cost\n(s1_3_cost, Rowley)"]; sf [label="sf\n(utils/sf)"];
  }

  // main_section2: S2_1 results -> S2_2 tables + every graph
  main -> {section1_splits run_systems_analysis create_table_of_masses plot_breakdown plot_vl_vs_sl plot_vehicle_sketch sweep_dv1 plot_dv1_sweep plot_team_designs plot_team_scatter plot_group_matrix summary tag_of};
  s21main -> {run_systems_analysis print_vehicle_results};
  run_systems_analysis -> {choose_diameter _size_vehicle};
  choose_diameter -> _size_vehicle;
  _size_vehicle -> {calculate_stage_masses calculate_stage_subsystems stage_cost stage_engine};
  calculate_stage_subsystems -> {calculate_propellant_geometry stage_layout calculate_engine_count engine_base_diameter stage_engine};
  calculate_engine_count -> stage_engine;
  calculate_stage_subsystems -> {mer_tank_mass mer_insulation_mass mer_engine_mass mer_thrust_structure_mass mer_solid_casing_mass mer_gimbal_mass mer_avionics_mass mer_wiring_mass mer_payload_fairing_mass mer_intertank_mass mer_interstage_mass mer_aft_fairing_mass};
  {mer_payload_fairing_mass mer_intertank_mass mer_interstage_mass mer_aft_fairing_mass} -> mer_fairing_mass;
  calculate_propellant_geometry -> tank_shape;
  stage_layout -> {cylinder_side_area cone_side_area frustum_side_area};
  print_vehicle_results -> print_stage_results;

  // S2_2: all ten designs through S2_1_HCR
  s22main -> generate_all_tables;
  generate_all_tables -> {hcr_run create_table_of_masses};
  create_table_of_masses -> {stage_cost sf};

  // S2_1_HCR
  hcrmain -> solve_vehicle;
  hcr_run -> {solve_vehicle format_stage_for_s2_2 get_stage_prop_specs calculate_stage_masses stage_cost};
  solve_vehicle -> {size_stage get_stage_prop_specs calculate_stage_masses stage_cost};
  size_stage -> {get_stage_prop_specs tank_geometry payload_fairing_geometry shell_fairing_mass engine_pack_diameter};
  payload_fairing_geometry -> shell_fairing_mass;
  format_stage_for_s2_2 -> {get_stage_prop_specs engine_pack_diameter};

  // cross-check
  xmain -> {henry_diameter s2_1};
  henry_diameter -> solve_vehicle;
  s2_1 -> _size_vehicle;

  // graphs
  section1_splits -> {calculate_stage_masses stage_cost};
  sweep_dv1 -> {choose_diameter calculate_stage_masses stage_cost};
  plot_vl_vs_sl -> stage_cost;
}
